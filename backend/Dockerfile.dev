FROM python:3.11-slim

LABEL maintainer="CloudShield IQ Project"
LABEL description="CloudShield IQ Backend — Development"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
# Separate COPY for pyproject.toml enables Docker layer caching
COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[dev]"

# Copy source (overridden by volume mount in dev)
COPY . .

EXPOSE 8000

# uvicorn with --reload for development hot-reloading
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
