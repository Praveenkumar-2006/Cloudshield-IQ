# ============================================================
# CloudShield IQ — Backend Environment Variables
# Copy this to .env and fill in values. NEVER commit .env
# ============================================================

# ----- Application -----
APP_NAME=CloudShield IQ
APP_ENV=development
DEBUG=false
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://cloudshield:REPLACE_PASSWORD@localhost:5432/cloudshield_iq
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ----- JWT -----
JWT_SECRET_KEY=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- File Upload -----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.csv,.json

# ----- ML -----
MODEL_DIR=./ml/models
MODEL_VERSION=v0.1.0

# ----- LLM (Optional — leave blank to disable) -----
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=1000

# ----- Cloud Providers (Phase 2+) -----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# GCP_PROJECT_ID=
# GCP_CREDENTIALS_PATH=

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json
